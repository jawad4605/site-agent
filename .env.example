# ── AI models (set at least ONE) ─────────────────────────────
# Tried in this order: Claude → ChatGPT → Gemini → Groq. If one fails, the next is used.
# Users can also connect their OWN key in the app (⚙️ Connections) — that one is tried first.

# 1. Claude (best quality, paid) — console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ChatGPT (OpenAI, paid) — platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol

# 2. Groq (FREE, very fast) — console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b        (sees screenshots)
# GROQ_TEXT_MODEL=openai/gpt-oss-120b (backup, text-only)

# 3. Google Gemini (FREE tier) — aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Each Gemini model has its own free quota; these are tried next when one runs out:
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional: any other OpenAI-compatible API (OpenRouter, Together, local Ollama...)
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# FALLBACK_API_KEY=
# FALLBACK_MODEL=

# ── Testing without any key ──────────────────────────────────
# MOCK_LLM=1

# ── Local dev only: path to Chrome if auto-detect fails ──────
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── One-click connections ────────────────────────────────────
# Encrypts the connection cookies. Any long random string (keep it secret).
SESSION_SECRET=

# "Connect GitHub" button — create an OAuth App at github.com/settings/developers
#   Homepage URL:   http://localhost:3000   (or your Vercel URL)
#   Callback URL:   http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# "Connect AI" (OpenRouter) needs no setup: users sign in on openrouter.ai.

# Real photos that match each business (free key: pexels.com/api). Optional.
PEXELS_API_KEY=
